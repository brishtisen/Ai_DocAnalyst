/* ==========================================================================
   DOCANALYST VISUAL REFRESH
   UI-only styling. Existing React components and behavior remain unchanged.
   ========================================================================== */

:root {
  --font-sans: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  --font-mono: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;

  --color-bg: #070b14;
  --color-surface: #0d1322;
  --color-surface-hover: #151d31;
  --color-surface-raised: #111a2c;
  --color-border: rgba(148, 163, 184, 0.12);
  --color-border-hover: rgba(129, 140, 248, 0.38);
  --color-text-primary: #f7f8ff;
  --color-text-secondary: #a7b0c5;
  --color-text-muted: #69758d;

  --color-accent: #7477ff;
  --color-accent-hover: #6467f5;
  --color-accent-light: rgba(116, 119, 255, 0.13);
  --color-accent-glow: rgba(116, 119, 255, 0.28);

  --color-success: #34d399;
  --color-success-bg: rgba(52, 211, 153, 0.10);
  --color-warning: #fbbf24;
  --color-danger: #fb7185;
  --color-danger-bg: rgba(251, 113, 133, 0.10);

  --shadow-sm: 0 4px 12px rgba(0,0,0,.14);
  --shadow-md: 0 12px 30px rgba(0,0,0,.20);
  --shadow-lg: 0 24px 70px rgba(0,0,0,.28);
  --shadow-glow: 0 0 0 1px rgba(116,119,255,.10), 0 12px 40px rgba(116,119,255,.14);

  --border-radius-sm: 8px;
  --border-radius-md: 12px;
  --border-radius-lg: 18px;
  --border-radius-xl: 24px;

  --transition-fast: .16s ease;
  --transition-normal: .28s cubic-bezier(.4,0,.2,1);
}

[data-theme="light"] {
  --color-bg: #f4f6fb;
  --color-surface: #ffffff;
  --color-surface-hover: #f0f2f8;
  --color-surface-raised: #ffffff;
  --color-border: rgba(15, 23, 42, .09);
  --color-border-hover: rgba(79, 70, 229, .28);
  --color-text-primary: #111827;
  --color-text-secondary: #596579;
  --color-text-muted: #8490a5;

  --color-accent: #5b5ff0;
  --color-accent-hover: #4d51dc;
  --color-accent-light: rgba(91,95,240,.09);
  --color-accent-glow: rgba(91,95,240,.18);

  --color-success-bg: rgba(16,185,129,.10);
  --color-danger-bg: rgba(239,68,68,.09);

  --shadow-sm: 0 4px 14px rgba(15,23,42,.05);
  --shadow-md: 0 12px 32px rgba(15,23,42,.08);
  --shadow-lg: 0 25px 60px rgba(15,23,42,.12);
  --shadow-glow: 0 0 0 1px rgba(91,95,240,.08), 0 12px 34px rgba(91,95,240,.10);
}

* { box-sizing: border-box; margin: 0; padding: 0; }

html, body, #root { width: 100%; height: 100%; }

body {
  font-family: var(--font-sans);
  background:
    radial-gradient(circle at 18% 8%, rgba(116,119,255,.07), transparent 28%),
    radial-gradient(circle at 88% 88%, rgba(99,102,241,.045), transparent 25%),
    var(--color-bg);
  color: var(--color-text-primary);
  line-height: 1.6;
  overflow: hidden;
  transition: background-color var(--transition-normal), color var(--transition-normal);
}

button, input, textarea { font-family: inherit; font-size: inherit; color: inherit; }
button { -webkit-tap-highlight-color: transparent; }
a { color: var(--color-accent); text-decoration: none; }
a:hover { text-decoration: underline; }

/* ==========================================================================
   APP SHELL
   ========================================================================== */

.app-container {
  display: flex;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: transparent;
}

.sidebar {
  width: 292px;
  min-width: 292px;
  height: 100%;
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 10;
  background:
    linear-gradient(180deg, rgba(255,255,255,.018), transparent 30%),
    var(--color-surface);
  border-right: 1px solid var(--color-border);
  box-shadow: 10px 0 40px rgba(0,0,0,.08);
  transition: background-color var(--transition-normal), border-color var(--transition-normal);
}

.main-workspace {
  flex: 1;
  min-width: 0;
  height: 100%;
  display: flex;
  position: relative;
  overflow: hidden;
}

.chat-container {
  flex: 1;
  min-width: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(circle at 72% 0%, rgba(116,119,255,.055), transparent 34%),
    var(--color-bg);
}

/* ==========================================================================
   SIDEBAR
   ========================================================================== */

.sidebar-header {
  padding: 22px 20px 18px;
  border-bottom: 1px solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.logo-container { display: flex; align-items: center; gap: 11px; }

.logo-icon {
  color: var(--color-accent);
  filter: drop-shadow(0 0 10px rgba(116,119,255,.28));
}

.logo-text {
  font-size: 1.13rem;
  font-weight: 750;
  letter-spacing: -.55px;
}

.new-chat-btn {
  width: calc(100% - 32px);
  margin: 16px 16px 12px;
  padding: 12px 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border: 1px solid rgba(255,255,255,.10);
  border-radius: 13px;
  background: linear-gradient(135deg, var(--color-accent), #6668ee);
  color: #fff;
  font-weight: 650;
  cursor: pointer;
  box-shadow: 0 10px 28px rgba(99,102,241,.22), inset 0 1px rgba(255,255,255,.18);
  transition: transform var(--transition-fast), filter var(--transition-fast), box-shadow var(--transition-fast);
}

.new-chat-btn:hover {
  filter: brightness(1.07);
  transform: translateY(-1px);
  box-shadow: 0 14px 32px rgba(99,102,241,.28), inset 0 1px rgba(255,255,255,.20);
}
.new-chat-btn:active { transform: translateY(0) scale(.985); }

.sidebar-section {
  flex: 1;
  overflow-y: auto;
  padding: 10px 14px 18px;
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.sidebar-title {
  margin: 0 5px 9px;
  color: var(--color-text-muted);
  font-size: .69rem;
  line-height: 1;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: .12em;
}

.sessions-list { display: flex; flex-direction: column; gap: 4px; }

.session-item {
  min-height: 40px;
  padding: 9px 10px;
  display: flex;
  align-items: center;
  gap: 8px;
  border: 1px solid transparent;
  border-radius: 10px;
  color: var(--color-text-secondary);
  cursor: pointer;
  transition: background var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast);
}

.session-item:hover {
  background: var(--color-surface-hover);
  color: var(--color-text-primary);
  border-color: var(--color-border);
}

.session-item.active {
  background: linear-gradient(90deg, var(--color-accent-light), rgba(116,119,255,.055));
  color: var(--color-text-primary);
  border-color: rgba(116,119,255,.18);
  box-shadow: inset 3px 0 0 var(--color-accent);
}

.session-item.active svg { color: var(--color-accent); }

.session-title-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: .86rem;
}

.delete-session-btn,
.delete-doc-btn {
  border: 0;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-muted);
  cursor: pointer;
  border-radius: 7px;
  padding: 5px;
  opacity: 0;
  transition: opacity var(--transition-fast), background var(--transition-fast), color var(--transition-fast);
}

.session-item:hover .delete-session-btn,
.doc-item-row:hover .delete-doc-btn { opacity: 1; }

.delete-session-btn:hover,
.delete-doc-btn:hover {
  color: var(--color-danger);
  background: var(--color-danger-bg);
}

/* ==========================================================================
   UPLOAD + DOCUMENTS
   ========================================================================== */

.upload-zone {
  min-height: 104px;
  padding: 18px 14px;
  border: 1px dashed rgba(116,119,255,.35);
  border-radius: 14px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 7px;
  text-align: center;
  cursor: pointer;
  background:
    radial-gradient(circle at 50% 0%, rgba(116,119,255,.10), transparent 65%),
    rgba(116,119,255,.025);
  transition: border-color var(--transition-fast), background var(--transition-fast), transform var(--transition-fast), box-shadow var(--transition-fast);
}

.upload-zone:hover {
  border-color: var(--color-accent);
  background:
    radial-gradient(circle at 50% 0%, rgba(116,119,255,.16), transparent 68%),
    var(--color-accent-light);
  transform: translateY(-1px);
  box-shadow: var(--shadow-glow);
}

.upload-icon { color: var(--color-accent); }
.upload-text { color: var(--color-text-secondary); font-size: .78rem; }
.upload-text span { color: var(--color-accent); font-weight: 700; }

.upload-progress-container { width: 100%; margin-top: 5px; }
.progress-bar-bg {
  width: 100%;
  height: 5px;
  overflow: hidden;
  border-radius: 99px;
  background: var(--color-border);
}
.progress-bar-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #5b5ff0, #8b8dff);
  box-shadow: 0 0 12px rgba(116,119,255,.45);
  transition: width .3s ease;
}

.docs-list { display: flex; flex-direction: column; gap: 8px; }

.doc-item-row {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 10px;
  border: 1px solid var(--color-border);
  border-radius: 13px;
  background: linear-gradient(145deg, rgba(255,255,255,.025), transparent), var(--color-bg);
  box-shadow: 0 3px 12px rgba(0,0,0,.06);
  transition: border-color var(--transition-fast), background var(--transition-fast), transform var(--transition-fast), box-shadow var(--transition-fast);
}

.doc-item-row:hover {
  border-color: var(--color-border-hover);
  background: var(--color-surface-hover);
  transform: translateY(-1px);
  box-shadow: var(--shadow-sm);
}

.doc-item-row.selected {
  border-color: rgba(116,119,255,.52);
  background: linear-gradient(145deg, var(--color-accent-light), transparent), var(--color-bg);
  box-shadow: 0 0 0 1px rgba(116,119,255,.08), 0 8px 22px rgba(99,102,241,.08);
}

.doc-info { flex: 1; min-width: 0; }
.doc-name {
  color: var(--color-text-primary);
  font-size: .82rem;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.doc-meta {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 3px;
  color: var(--color-text-secondary);
  font-size: .69rem;
}

.status-badge {
  padding: 2px 7px;
  border-radius: 99px;
  font-size: .62rem;
  font-weight: 750;
  letter-spacing: .02em;
}
.status-badge.processing { color: var(--color-warning); background: rgba(251,191,36,.10); }
.status-badge.ready { color: var(--color-success); background: var(--color-success-bg); }
.status-badge.failed { color: var(--color-danger); background: var(--color-danger-bg); }

.sidebar-footer {
  padding: 13px 16px;
  border-top: 1px solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255,255,255,.012);
}

.theme-toggle-btn {
  width: 32px;
  height: 32px;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--color-border);
  border-radius: 9px;
  background: var(--color-bg);
  color: var(--color-text-secondary);
  cursor: pointer;
  transition: transform var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast), background var(--transition-fast);
}
.theme-toggle-btn:hover {
  color: var(--color-text-primary);
  border-color: var(--color-border-hover);
  background: var(--color-surface-hover);
  transform: rotate(8deg);
}

/* ==========================================================================
   CHAT HEADER
   ========================================================================== */

.chat-header {
  min-height: 68px;
  padding: 14px 26px;
  border-bottom: 1px solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(13,19,34,.72);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  position: relative;
  z-index: 2;
}

[data-theme="light"] .chat-header {
  background: rgba(255,255,255,.78);
}

.chat-header-info { display: flex; align-items: center; gap: 11px; }

.chat-header h2 {
  letter-spacing: -.2px;
}

.active-filters-pill {
  padding: 4px 10px;
  border: 1px solid rgba(116,119,255,.20);
  border-radius: 99px;
  background: var(--color-accent-light);
  color: var(--color-accent);
  font-size: .69rem;
  font-weight: 700;
}

/* ==========================================================================
   MESSAGE FEED
   ========================================================================== */

.chat-messages {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 34px 28px 36px;
  display: flex;
  flex-direction: column;
  gap: 28px;
  scroll-behavior: smooth;
}

.message-bubble {
  width: min(900px, 100%);
  margin: 0 auto;
  display: flex;
  align-items: flex-start;
  gap: 14px;
  animation: messageIn .32s cubic-bezier(.2,.8,.2,1);
}

.message-avatar {
  width: 38px;
  height: 38px;
  flex: 0 0 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--color-border);
  border-radius: 11px;
  background: linear-gradient(145deg, var(--color-surface-hover), var(--color-surface));
  color: var(--color-text-secondary);
  box-shadow: var(--shadow-sm);
}

.message-avatar.model {
  color: var(--color-accent);
  border-color: rgba(116,119,255,.20);
  background: linear-gradient(145deg, var(--color-accent-light), var(--color-surface));
  box-shadow: 0 7px 22px rgba(99,102,241,.10);
}

.message-avatar.user {
  color: #fff;
  border-color: rgba(116,119,255,.24);
  background: linear-gradient(145deg, var(--color-accent), #5558db);
}

.message-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.message-sender {
  color: var(--color-text-secondary);
  font-size: .76rem;
  font-weight: 750;
  letter-spacing: .01em;
}

.message-text {
  font-size: .94rem;
  line-height: 1.72;
  color: var(--color-text-primary);
}

.message-text p { margin-bottom: 10px !important; }
.message-text strong { font-weight: 720; }

.message-text h1,
.message-text h2,
.message-text h3 {
  margin: 22px 0 9px;
  color: var(--color-text-primary);
  letter-spacing: -.025em;
  line-height: 1.25;
}
.message-text h1 { font-size: 1.45rem; }
.message-text h2 { font-size: 1.18rem; }
.message-text h3 { font-size: 1.02rem; }

.message-text ul,
.message-text ol {
  margin: 10px 0 12px 22px !important;
}
.message-text li { padding-left: 4px; margin: 3px 0; }

.message-text code {
  padding: 2px 6px;
  border: 1px solid var(--color-border);
  border-radius: 6px;
  background: var(--color-surface-hover);
  color: #c9ccff;
  font-family: var(--font-mono);
  font-size: .84em;
}

[data-theme="light"] .message-text code { color: #4548a7; }

.message-text pre {
  margin: 15px 0;
  padding: 17px 18px;
  overflow-x: auto;
  border: 1px solid var(--color-border);
  border-radius: 13px;
  background: #080d18;
  box-shadow: inset 0 1px rgba(255,255,255,.03), var(--shadow-sm);
}

[data-theme="light"] .message-text pre { background: #111827; }

.message-text pre code {
  padding: 0;
  border: 0;
  background: transparent;
  color: #e5e7eb;
  font-size: .84rem;
}

.message-text table {
  width: 100%;
  margin: 16px 0;
  border-collapse: separate;
  border-spacing: 0;
  overflow: hidden;
  border: 1px solid var(--color-border);
  border-radius: 12px;
  font-size: .84rem;
}

.message-text th,
.message-text td {
  padding: 9px 12px;
  border-right: 1px solid var(--color-border);
  border-bottom: 1px solid var(--color-border);
  text-align: left;
}

.message-text th {
  background: var(--color-surface-hover);
  color: var(--color-text-primary);
  font-weight: 700;
}
.message-text tr:last-child td { border-bottom: 0; }
.message-text th:last-child,
.message-text td:last-child { border-right: 0; }
.message-text tbody tr:nth-child(even) { background: rgba(255,255,255,.015); }

.table-responsive { border-radius: 12px; }

.citation-pill {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  max-width: 100%;
  padding: 3px 8px;
  margin: 0 3px;
  border: 1px solid rgba(116,119,255,.20);
  border-radius: 99px;
  background: var(--color-accent-light);
  color: var(--color-accent);
  font-size: .74rem;
  font-weight: 650;
  line-height: 1.35;
  cursor: pointer;
  white-space: nowrap;
  transition: transform var(--transition-fast), background var(--transition-fast), border-color var(--transition-fast);
}
.citation-pill:hover {
  transform: translateY(-1px);
  border-color: rgba(116,119,255,.42);
  background: rgba(116,119,255,.18);
  text-decoration: none;
}

.message-citations-block {
  margin-top: 12px;
  padding: 12px 0 0;
  border-top: 1px dashed var(--color-border);
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.citations-title {
  color: var(--color-text-muted);
  font-size: .67rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: .12em;
}
.citations-list-container { display: flex; flex-wrap: wrap; gap: 7px; }

.streaming-cursor::after {
  content: "▊";
  display: inline-block;
  margin-left: 2px;
  color: var(--color-accent);
  animation: blink 1s steps(2,start) infinite;
  font-size: .9rem;
}

/* ==========================================================================
   INPUT
   ========================================================================== */

.chat-input-container {
  padding: 16px 26px 22px;
  background: linear-gradient(180deg, transparent, var(--color-bg) 22%);
  position: relative;
  z-index: 3;
}

.chat-input-wrapper {
  width: min(900px, 100%);
  margin: 0 auto;
  padding: 9px 11px 9px 17px;
  display: flex;
  flex-direction: column;
  border: 1px solid var(--color-border);
  border-radius: 18px;
  background: rgba(13,19,34,.88);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  box-shadow: 0 18px 45px rgba(0,0,0,.22);
  transition: border-color var(--transition-fast), box-shadow var(--transition-fast), transform var(--transition-fast);
}

[data-theme="light"] .chat-input-wrapper { background: rgba(255,255,255,.90); }

.chat-input-wrapper:focus-within {
  border-color: rgba(116,119,255,.48);
  box-shadow: 0 0 0 3px rgba(116,119,255,.08), 0 20px 50px rgba(0,0,0,.20);
}

.chat-textarea {
  width: 100%;
  min-height: 44px;
  max-height: 200px;
  padding: 7px 0;
  border: 0;
  outline: 0;
  resize: none;
  background: transparent;
  line-height: 1.5;
  font-size: .93rem;
  color: var(--color-text-primary);
}
.chat-textarea::placeholder { color: var(--color-text-muted); }

.chat-input-controls {
  min-height: 30px;
  margin-top: 4px;
  padding-top: 7px;
  border-top: 1px solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.chat-input-meta { color: var(--color-text-muted); font-size: .68rem; }

.send-message-btn {
  width: 34px;
  height: 34px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 11px;
  background: linear-gradient(135deg, var(--color-accent), #5e61df);
  color: #fff;
  cursor: pointer;
  box-shadow: 0 6px 18px rgba(99,102,241,.22);
  transition: transform var(--transition-fast), filter var(--transition-fast), box-shadow var(--transition-fast);
}
.send-message-btn:hover:not(:disabled) {
  filter: brightness(1.08);
  transform: translateY(-1px) scale(1.03);
  box-shadow: 0 9px 22px rgba(99,102,241,.30);
}
.send-message-btn:active:not(:disabled) { transform: scale(.97); }
.send-message-btn:disabled {
  background: var(--color-surface-hover);
  color: var(--color-text-muted);
  box-shadow: none;
  cursor: not-allowed;
}

/* ==========================================================================
   EMPTY / WELCOME STATE
   ========================================================================== */

.chat-empty-state {
  width: min(680px, 100%);
  margin: auto;
  padding: 42px 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 17px;
  text-align: center;
  animation: fadeIn .45s ease;
}

.welcome-icon-box {
  width: 68px;
  height: 68px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(116,119,255,.20);
  border-radius: 20px;
  background: linear-gradient(145deg, rgba(116,119,255,.18), rgba(116,119,255,.05));
  color: var(--color-accent);
  box-shadow: var(--shadow-glow);
}

.welcome-title {
  font-size: 1.72rem;
  font-weight: 760;
  letter-spacing: -.045em;
}

.welcome-desc {
  max-width: 590px;
  color: var(--color-text-secondary);
  font-size: .9rem;
  line-height: 1.7;
}

.starter-questions-grid {
  width: 100%;
  margin-top: 10px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.starter-card {
  min-height: 92px;
  padding: 14px 16px;
  border: 1px solid var(--color-border);
  border-radius: 14px;
  background: linear-gradient(145deg, rgba(255,255,255,.025), transparent), var(--color-surface);
  text-align: left;
  cursor: pointer;
  box-shadow: 0 5px 18px rgba(0,0,0,.07);
  transition: transform var(--transition-fast), border-color var(--transition-fast), background var(--transition-fast), box-shadow var(--transition-fast);
}

.starter-card:hover {
  transform: translateY(-2px);
  border-color: rgba(116,119,255,.34);
  background: linear-gradient(145deg, var(--color-accent-light), transparent), var(--color-surface);
  box-shadow: 0 12px 28px rgba(0,0,0,.12), 0 0 24px rgba(99,102,241,.06);
}
.starter-card strong { font-size: .86rem; }
.starter-card p { line-height: 1.5; }

/* ==========================================================================
   PDF VIEWER
   ========================================================================== */

.pdf-viewer-container {
  width: 45%;
  min-width: 380px;
  height: 100%;
  display: flex;
  flex-direction: column;
  position: relative;
  background: var(--color-surface);
  border-left: 1px solid var(--color-border);
  box-shadow: -16px 0 40px rgba(0,0,0,.10);
  transition: width var(--transition-normal), transform var(--transition-normal), border-color var(--transition-normal);
}

.pdf-viewer-container.collapsed {
  width: 0;
  min-width: 0;
  transform: translateX(100%);
  border-left: 0;
}

.viewer-toggle-btn {
  position: absolute;
  top: 50%;
  left: -23px;
  width: 23px;
  height: 66px;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--color-border);
  border-right: 0;
  border-radius: 11px 0 0 11px;
  background: var(--color-surface);
  color: var(--color-text-secondary);
  cursor: pointer;
  transform: translateY(-50%);
  z-index: 20;
  box-shadow: -5px 0 16px rgba(0,0,0,.08);
  transition: color var(--transition-fast), background var(--transition-fast);
}
.viewer-toggle-btn:hover {
  color: var(--color-accent);
  background: var(--color-surface-hover);
}

.pdf-viewer-header {
  min-height: 66px;
  padding: 13px 18px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  border-bottom: 1px solid var(--color-border);
  background: rgba(255,255,255,.018);
}

.pdf-viewer-title-block {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 9px;
}

.pdf-doc-name {
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: .84rem;
  font-weight: 650;
}

.pdf-close-btn {
  width: 32px;
  height: 32px;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid transparent;
  border-radius: 9px;
  background: transparent;
  color: var(--color-text-secondary);
  cursor: pointer;
  transition: color var(--transition-fast), background var(--transition-fast), border-color var(--transition-fast);
}
.pdf-close-btn:hover {
  color: var(--color-text-primary);
  background: var(--color-surface-hover);
  border-color: var(--color-border);
}

.pdf-frame-wrapper {
  flex: 1;
  min-height: 0;
  position: relative;
  background: #171b25;
}

.pdf-iframe {
  width: 100%;
  height: 100%;
  border: 0;
  display: block;
  background: #171b25;
}

.pdf-placeholder {
  height: 100%;
  padding: 40px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14px;
  text-align: center;
  color: var(--color-text-secondary);
}
.pdf-placeholder-icon {
  color: var(--color-text-muted);
  opacity: .7;
}

/* ==========================================================================
   SCROLLBARS / MOTION
   ========================================================================== */

::-webkit-scrollbar { width: 7px; height: 7px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb {
  background: rgba(148,163,184,.18);
  border-radius: 99px;
}
::-webkit-scrollbar-thumb:hover { background: rgba(148,163,184,.30); }

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(9px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes messageIn {
  from { opacity: 0; transform: translateY(7px); }
  to { opacity: 1; transform: translateY(0); }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
    scroll-behavior: auto !important;
  }
}

/* ==========================================================================
   RESPONSIVE
   ========================================================================== */

@media (max-width: 1100px) {
  .sidebar { width: 260px; min-width: 260px; }
  .pdf-viewer-container { width: 42%; min-width: 340px; }
  .chat-messages { padding-left: 20px; padding-right: 20px; }
  .chat-input-container { padding-left: 20px; padding-right: 20px; }
}

@media (max-width: 820px) {
  .app-container { flex-direction: column; }
  .sidebar {
    width: 100%;
    min-width: 0;
    height: auto;
    max-height: 42vh;
    border-right: 0;
    border-bottom: 1px solid var(--color-border);
  }
  .sidebar-header { padding: 13px 16px; }
  .new-chat-btn { margin: 10px 14px; width: calc(100% - 28px); }
  .sidebar-section { padding: 6px 12px 12px; gap: 14px; }
  .sidebar-footer { display: none; }
  .main-workspace { flex: 1; min-height: 0; flex-direction: column; }
  .pdf-viewer-container {
    width: 100%;
    min-width: 0;
    height: 48vh;
    border-left: 0;
    border-top: 1px solid var(--color-border);
  }
  .pdf-viewer-container.collapsed {
    width: 100%;
    height: 0;
    transform: translateY(100%);
  }
  .viewer-toggle-btn { left: 50%; top: -23px; width: 66px; height: 23px; border-right: 1px solid var(--color-border); border-bottom: 0; border-radius: 10px 10px 0 0; transform: translateX(-50%); }
  .starter-questions-grid { grid-template-columns: 1fr; }
  .chat-header { padding: 12px 16px; }
  .chat-messages { padding: 24px 14px 28px; }
  .chat-input-container { padding: 12px 14px 15px; }
}

@media (max-width: 520px) {
  .sidebar { max-height: 36vh; }
  .chat-empty-state { padding: 28px 16px; }
  .welcome-title { font-size: 1.45rem; }
  .welcome-desc { font-size: .84rem; }
  .message-bubble { gap: 9px; }
  .message-avatar { width: 32px; height: 32px; flex-basis: 32px; border-radius: 9px; }
  .message-text { font-size: .9rem; }
  .chat-input-meta { font-size: .62rem; }
  .citation-pill { max-width: 100%; overflow: hidden; text-overflow: ellipsis; }
}
