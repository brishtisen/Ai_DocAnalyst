# Gemini API Key for Embeddings, OCR, Reranking, and LLM Chat Completion
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Model overrides (defaults to gemini-2.5-flash and text-embedding-004)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Configuration (Optional: set only when deploying frontend and backend to different domains)
# VITE_API_URL=https://your-backend-service.onrender.com

